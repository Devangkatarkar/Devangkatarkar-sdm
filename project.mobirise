    "index.html": {
      "settings": {
        "main": true,
        "title": "My Personal Portfoio | Devang Katarkar",
        "meta_descr": "Devang Katarkar’s personal portfolio showcasing modern web development projects, React applications, clean UI design, animations, and real-world full-stack solutions.",
